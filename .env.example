APP_ENV=development

AI_PROVIDER=ollama

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_REQUEST_TIMEOUT=120

# Optional: only needed if AI_PROVIDER=claude in the future. Never expose to frontend.
ANTHROPIC_API_KEY=

DATABASE_URL=sqlite:///./msingi.db

# Origins allowed to call this API from a browser (comma-separated).
# The Vite dev server runs on 5173 by default.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

CURRICULUM_RAW_DIR=curriculum/raw
CURRICULUM_VECTORSTORE_DIR=curriculum/vectorstore
CHROMA_COLLECTION_NAME=msingi_curriculum

CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVER_TOP_K=4
