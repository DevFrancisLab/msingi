# Public, non-secret config only — anything prefixed VITE_ is bundled into
# the browser build in plain text. Never put API keys or credentials here.

# Base URL of the FastAPI backend. Optional — defaults to
# http://localhost:8000 in code (see src/api/client.ts) if unset, which
# matches `uvicorn app.main:app` run from backend/ with its default port.
# Set this only when the backend runs somewhere else (a different port, a
# staging host, a separately-deployed build).
VITE_API_BASE_URL=http://localhost:8000
